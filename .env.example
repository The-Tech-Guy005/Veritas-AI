# Veritas AI Configuration

# Optional: enable live web search
TAVILY_API_KEY=

# Optional: enable Gemini LLM synthesis and reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MASTER_MODEL=gemini-2.0-flash

# Storage & Processing
DATA_DIR=./data
REPORTS_DIR=./data/reports
CHROMA_COLLECTION=veritas_documents
MAX_UPLOAD_MB=20
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_SUBTASKS=6
EVIDENCE_THRESHOLD_SCORE=70
SUBAGENT_TIMEOUT_SECONDS=30

# Nonilion Integration (Bot API / Webhook / Polling)
NONILION_BOT_NAME="Veritas AI Master"
NONILION_API_URL=https://api.nonilion.com/v1
NONILION_BOT_TOKEN=
NONILION_PAIRING_CODE=
NONILION_ROOM_ID=
NONILION_WEBHOOK_SECRET=
NONILION_POLL_INTERVAL_SECONDS=5
